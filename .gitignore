# Python backend
# .venv, compiled helper, outputs, test docs and the machine-specific lock file
# are all regenerated by setup.sh — never commit them.
Backend/.venv/
Backend/bin/
Backend/out/
Backend/testdata/
Backend/requirements.lock.txt
**/__pycache__/
*.pyc

# Swift / SwiftPM build products
App/.build/
App/DocDigitizer.app/

# Generated icon intermediates (AppIcon.icns and icon.png ARE committed)
Resources/AppIcon.iconset/

# macOS
.DS_Store
